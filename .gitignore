# Go / native build output
dist/
bin/
*.exe
*.test
*.out
*.aar
*.dll
*.dylib
*.so

# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
**/doc/api/

# Android
**/.gradle/
**/local.properties
**/captures/

# IDE / OS
.idea/
*.iml
.vscode/
.DS_Store

# Generated desktop/android libraries (keep the directories).
# c-shared builds also emit a C header next to the library.
app/windows/libs/*
!app/windows/libs/.gitkeep
app/macos/libs/*
!app/macos/libs/.gitkeep
app/linux/libs/*
!app/linux/libs/.gitkeep
app/android/app/libs/*
!app/android/app/libs/.gitkeep

# Packaged apps / mobile bindings
*.apk
*.aab
*.ipa
*.xcframework/
*.dmg
*.msix
