// Merge into app/android/app/build.gradle.kts after `flutter create`.
// scripts/patch-android-gradle.sh appends the dependency and sets minSdk when it can.
// fileTree stays empty when clickspirit.aar has not been built yet, so the
// Gradle configuration still succeeds.
//
// android {
//     defaultConfig {
//         minSdk = 24
//     }
// }

dependencies {
    implementation(fileTree(mapOf("dir" to "libs", "include" to listOf("*.aar"))))
}
